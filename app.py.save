
from flask import Flask, render_template, request, redirect, session
import sqlite3, datetime, uuid
from cryptography.hazmat.primitives import serialization, hashes
from cryptography.hazmat.primitives.asymmetric import padding

app = Flask(__name__)
app.secret_key = "secreto"


# ================= BASE DE DATOS =================
def init_db():
    conn = sqlite3.connect("database.db")
    c = conn.cursor()

    c.execute('''
    CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        username TEXT,
        password TEXT
    )
    ''')

    c.execute('''
    CREATE TABLE IF NOT EXISTS messages (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        texto_cifrado TEXT,
        token TEXT,
        estado TEXT,
        fecha_creacion TEXT,
        fecha_uso TEXT,
        expiracion TEXT
    )
    ''')

    c.execute('''
    CREATE TABLE IF NOT EXISTS history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        token TEXT,
        fecha TEXT,
        accion TEXT
    )
    ''')

    conn.commit()
    conn.close()

init_db()


# ================= CIFRADO =================
def cargar_llaves():
    with open("keys/private.pem", "rb") as f:
        private_key = serialization.load_pem_private_key(f.read(), password=None)

    with open("keys/public.pem", "rb") as f:
        public_key = serialization.load_pem_public_key(f.read())

    return private_key, public_key


def cifrar(texto):
    _, public_key = cargar_llaves()
    cifrado = public_key.encrypt(
        texto.encode(),
        padding.OAEP(
            mgf=padding.MGF1(algorithm=hashes.SHA256()),
            algorithm=hashes.SHA256(),
            label=None
        )
    )
    return cifrado.hex()


def descifrar(texto_cifrado):
    private_key, _ = cargar_llaves()
    texto = private_key.decrypt(
        bytes.fromhex(texto_cifrado),
        padding.OAEP(
            mgf=padding.MGF1(algorithm=hashes.SHA256()),
            algorithm=hashes.SHA256(),
            label=None
        )
    )
    return texto.decode()


def generar_token():
    return str(uuid.uuid4())


# ================= LOGIN =================
@app.route("/", methods=["GET","POST"])
def login():
    if request.method == "POST":
        u = request.form["username"]
        p = request.form["password"]

        conn = sqlite3.connect("database.db")
        c = conn.cursor()
        c.execute("SELECT * FROM users WHERE username=? AND password=?", (u,p))
        user = c.fetchone()

        if user:
            session["user_id"] = user[0]
            return redirect("/dashboard")

    return render_template("login.html")


# ================= REGISTRO =================
@app.route("/register", methods=["GET","POST"])
def register():
    if request.method == "POST":
        u = request.form["username"]
        p = request.form["password"]

        conn = sqlite3.connect("database.db")
        c = conn.cursor()
        c.execute("INSERT INTO users (username,password) VALUES (?,?)",(u,p))
        conn.commit()
        conn.close()

        return redirect("/")

    return render_template("register.html")


# ================= DASHBOARD =================
@app.route("/dashboard")
def dashboard():
    if "user_id" not in session:
        return redirect("/")
    return render_template("dashboard.html")


# ================= CIFRAR =================
@app.route("/cifrar", methods=["GET","POST"])
def cifrar_view():
    if "user_id" not in session:
        return redirect("/")

    if request.method == "POST":
        texto = request.form["texto"]

        cifrado = cifrar(texto)
        token = generar_token()

        ahora = datetime.datetime.now()
        exp = ahora + datetime.timedelta(days=7)

        conn = sqlite3.connect("database.db")
        c = conn.cursor()

        c.execute('''
        INSERT INTO messages 
        (user_id,texto_cifrado,token,estado,fecha_creacion,expiracion)
        VALUES (?,?,?,?,?,?)
        ''', (session["user_id"], cifrado, token, "activo", str(ahora), str(exp)))

        conn.commit()
        conn.close()

        return f"Token generado: {token}"

    return render_template("cifrar.html")


# ================= USAR TOKEN =================
@app.route("/ver", methods=["GET","POST"])
def ver():
    if request.method == "POST":
        token = request.form["token"]

        conn = sqlite3.connect("database.db")
        c = conn.cursor()

        c.execute("SELECT * FROM messages WHERE token=?", (token,))
        msg = c.fetchone()

        ahora = datetime.datetime.now()

        c.execute("INSERT INTO history (token,fecha,accion) VALUES (?,?,?)",
                  (token, str(ahora), "intento"))

        if not msg:
            return "Token inválido"

        estado = msg[4]
        expiracion = datetime.datetime.fromisoformat(msg[7])

        if estado != "activo" or ahora > expiracion:
            return "Token inválido"

        texto = descifrar(msg[2])

        c.execute("UPDATE messages SET estado='usado', fecha_uso=? WHERE token=?",
                  (str(ahora), token))

        conn.commit()
        conn.close()

        return f"Texto: {texto}"

    return render_template("ver_token.html")


# ================= HISTORIAL =================
@app.route("/historial")
def historial():
    if "user_id" not in session:
        return redirect("/")

    conn = sqlite3.connect("database.db")
    c = conn.cursor()

    c.execute("SELECT * FROM messages WHERE user_id=?", (session["user_id"],))
    data = c.fetchall()

    conn.close()

    return render_template("historial.html", data=data)


# ================= ELIMINAR =================
@app.route("/eliminar/<token>")
def eliminar(token):
    conn = sqlite3.connect("database.db")
    c = conn.cursor()

    c.execute("UPDATE messages SET estado='eliminado' WHERE token=?", (token,))
    conn.commit()
    conn.close()

    return redirect("/historial")


# ================= RUN =================
if __name__ == "__main__":
    app.run(debug=True)
